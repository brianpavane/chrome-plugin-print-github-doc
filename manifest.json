{
  "manifest_version": 3,
  "name": "Print GitHub Doc",
  "version": "0.2.0",
  "description": "Cleanly print or save to PDF a GitHub markdown document, README, or wiki page.",
  "permissions": ["activeTab", "scripting", "storage", "declarativeContent"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Print this GitHub document",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Print the current GitHub document"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
